# Copy this file to .env and fill in your key. .env is gitignored, so your key
# never gets committed. Everything here is optional: with no key, Sentinel runs
# in rule-based mode and behaves exactly as it does without the LLM layer.

# Provider: auto | gemini | ollama | stub
# ollama = local models via http://127.0.0.1:11434 (no Google rate limits)
SENTINEL_LLM=ollama

# --- Gemini (when SENTINEL_LLM=auto|gemini) ---
# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=
# New API keys cannot use Gemini 2.5 models. Prefer 3.1 Flash-Lite or 3.5 Flash.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Ollama (when SENTINEL_LLM=ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Hard timeout per model call, in milliseconds.
# Ollama local runs often need 60s+; Gemini floor is 10s.
SENTINEL_LLM_TIMEOUT_MS=120000

# Set to 1 to run the triage agent for every patient on board load.
# With Ollama this is slow (minutes) but has no cloud rate limit.
# SENTINEL_LIVE_AGENT_BOARD=1
