# Copy this file to .env and fill in your key. .env is gitignored, so your key
# never gets committed. Everything here is optional: with no key, Sentinel runs
# in rule-based mode and behaves exactly as it does without the LLM layer.

# Get a free key at https://aistudio.google.com (no credit card for the free tier).
GEMINI_API_KEY=

# auto (use Gemini if a key is present, else rule-based), gemini, or stub.
SENTINEL_LLM=auto

# Any current free-tier flash model works. Check your live limits in AI Studio.
# Alternatives: gemini-2.5-flash, gemini-3.5-flash-lite, gemini-3.6-flash
GEMINI_MODEL=gemini-2.5-flash-lite

# Hard timeout per model call, in milliseconds. On timeout we use the fallback.
# Gemini requires at least 10000; lower values are raised to that floor.
SENTINEL_LLM_TIMEOUT_MS=15000
